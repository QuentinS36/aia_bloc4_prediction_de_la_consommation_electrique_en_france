# Copier ce fichier en airflow/.env puis remplir les valeurs (jamais versionné).
# Une variable par ligne, sans espace autour du = et sans commentaire en fin de ligne.

# --- AWS : utilisateur IAM dédié à Airflow (lancer, décrire et arrêter des instances, voir aws_iam_policy.json) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3

# --- Instance EC2 de calcul ---
AMI_ID=
SECURITY_GROUP_ID=
KEY_NAME=
# Chemin du fichier .pem de la paire de clés KEY_NAME, sur la machine qui exécute Airflow (script start_standalone.sh)
# Avec Docker, ce champ est inutile : copier la clé dans airflow/keys/ec2.pem
EC2_SSH_KEY_FILE=
# EC2_SSH_USER=ec2-user
# EC2_INSTANCE_TYPE=t3.large

# --- Docker Hub et API ---
DOCKERHUB_USER=
API_URL=
API_KEY=
