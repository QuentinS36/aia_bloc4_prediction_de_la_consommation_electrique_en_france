# Copier ce fichier en .env puis remplir les valeurs.
# Règles : une variable par ligne, pas d'espace autour du =, pas de commentaire en fin de ligne
# (Docker les prendrait pour une partie de la valeur). Ne jamais versionner .env.

# --- Source de consommation (RTE) ---
# base64 de "client_id:client_secret"
RTE_SECRET_KEY=

# --- Base de données des données (Neon) ---
DATABASE_URL=

# --- MLflow hébergé sur DagsHub ---
# URI : https://dagshub.com/<utilisateur>/<depot>.mlflow
MLFLOW_TRACKING_URI=
# Nom d'utilisateur DagsHub
MLFLOW_TRACKING_USERNAME=
# Jeton d'accès DagsHub (Settings > Tokens), pas le mot de passe du compte
MLFLOW_TRACKING_PASSWORD=

# --- Nom du modèle dans le registry (identique partout) ---
MODEL_NAME=dday-prophet-conso

# --- Optionnel : décommenter et remplir pour activer ---
# AWS n'est plus nécessaire à MLflow (les artifacts sont stockés par DagsHub).
# Il ne sert que si vous envoyez les rapports de monitoring sur S3 (REPORT_S3_URI).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-3
# REPORT_S3_URI=s3://nom-du-bucket/monitoring
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# API_KEY=
# MAPE_TARGET=0.03
# MAPE_ALERT=0.04
# DRIFT_SHARE_ALERT=0.5
